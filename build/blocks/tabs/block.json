{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fse-theme/tabs",
  "version": "1.0.0",
  "title": "FSE — Tabs",
  "category": "design",
  "icon": "index-card",
  "description": "Własny blok zakładek React.",
  "textdomain": "fse-theme",
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "attributes": {
    "tabs": {
      "type": "array",
      "default": [
        {
          "title": "Opis",
          "content": "Zawartość pierwszej zakładki."
        },
        {
          "title": "Specyfikacja",
          "content": "Zawartość drugiej zakładki."
        },
        {
          "title": "FAQ",
          "content": "Zawartość trzeciej zakładki."
        }
      ]
    },
    "tabStyle": {
      "type": "string",
      "default": "underline"
    },
    "maxTabs": {
      "type": "number",
      "default": 10
    }
  }
}