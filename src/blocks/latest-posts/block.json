{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fse-theme/latest-posts",
  "version": "1.0.0",
  "title": "FSE Latest Posts",
  "category": "widgets",
  "icon": "admin-post",
  "description": "Lista najnowszych wpisów WordPress.",
  "textdomain": "fse-theme",
  "supports": {
    "html": false
  },
  "attributes": {
    "postsToShow": {
      "type": "number",
      "default": 5
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "categoryId": {
      "type": "number",
      "default": 0
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "cardLayout": {
      "type": "string",
      "default": "vertical"
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "style": "file:./style-index.css"
}
